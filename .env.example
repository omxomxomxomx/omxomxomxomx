# Copy this file to .env and fill in your credentials

# ── X (Twitter) API ──────────────────────────────────────────────────────────
# Get your bearer token at: https://developer.twitter.com/en/portal/dashboard
# Free tier gives 500k tweets/month (read-only, recent tweets only)
X_BEARER_TOKEN=your_bearer_token_here

# Set to "true" after adding your X_BEARER_TOKEN to switch from mock to live data
ENABLE_LIVE_X=false

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
